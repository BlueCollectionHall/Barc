<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miaoyu.barc.notice.mapper.NoticeMapper">

<!--    查询最新的一条公告（限制在 day 天内）-->
<!--    排序补充 id 作为第二排序键，保证同一时间戳的多条公告返回结果稳定-->
    <select id="latest" resultType="com.miaoyu.barc.notice.model.NoticeModel">
        SELECT id, title, content, author, updated_at
        FROM notice
        WHERE updated_at >= DATE_SUB(now(), INTERVAL #{day} DAY)
        ORDER BY updated_at DESC, id DESC
        LIMIT 1
    </select>

<!--    查询全表最新的一条公告（不限时间）-->
<!--    用途：/notice/latest 在 day 天内查不到公告时的回退兜底，避免前端因公告超期而显示“暂无公告”-->
<!--    该语句不得再带任何时间过滤条件，否则会退化成原「超期即无公告」的缺陷-->
    <select id="latestWithoutDayLimit" resultType="com.miaoyu.barc.notice.model.NoticeModel">
        SELECT id, title, content, author, updated_at
        FROM notice
        ORDER BY updated_at DESC, id DESC
        LIMIT 1
    </select>

<!--    分页分条件查询公告-->
    <select id="selectByPage" resultType="com.miaoyu.barc.notice.model.NoticeModel">
        SELECT * FROM notice
        <where>
            <if test="condition.title != null and condition.title != ''">
                AND title LIKE CONCAT('%', #{condition.title}, '%')
            </if>
        </where>
        ORDER BY updated_at DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByPage" resultType="long">
        SELECT COUNT(*) FROM notice
        <where>
            <if test="condition.title != null and condition.title != ''">
                AND title LIKE CONCAT('%', #{condition.title}, '%')
            </if>
        </where>
    </select>
    
    <select id="selectById" resultType="com.miaoyu.barc.notice.model.NoticeModel">
        SELECT * FROM notice
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.miaoyu.barc.notice.model.NoticeModel">
        INSERT INTO notice (id, title, content, author) VALUES (#{id}, #{title}, #{content}, #{author})
    </insert>

    <update id="update" parameterType="com.miaoyu.barc.notice.model.NoticeModel">
        UPDATE notice SET title = #{title}, content = #{content} WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="com.miaoyu.barc.notice.model.NoticeModel">
        DELETE FROM notice WHERE id = #{id}
    </delete>

</mapper>